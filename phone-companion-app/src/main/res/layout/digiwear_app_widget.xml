<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- Recessed Bandai V-Pet LCD Sprite Frame -->
    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_lcd_frame"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_pet_sprite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="Virtual Pet Sprite"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- Digivice Telemetry Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Top Casing Label -->
        <TextView
            android:id="@+id/widget_tap_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈ DIGIWEAR // V-PET LINK ◈"
            android:textColor="#4DD0E1"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Name & Stage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Botamon"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pet_stage_attr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="• Baby I"
                android:textColor="#FFCA28"
                android:textSize="11sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>

        <!-- Hunger & Strength Meters -->
        <TextView
            android:id="@+id/widget_pet_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="♥♥♥♥  ★★★★"
            android:textColor="#FF8A80"
            android:textSize="12sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Weight & Battles / Step Info -->
        <TextView
            android:id="@+id/widget_pet_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Wt: 5g • Care: 0 • Battles: 0/0"
            android:textColor="#B0BEC5"
            android:textSize="10sp"
            android:typeface="monospace" />

        <!-- Quick Care Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_btn_feed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_btn_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="🍖 FEED"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/widget_btn_clean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="🧹 FLUSH"
                android:textColor="#00E5FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
